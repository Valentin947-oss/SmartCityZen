<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/institution_dialog_title"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editInstitutionName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/institution_name_hint"
        android:inputType="textCapSentences" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/institution_category_label"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <CheckBox
        android:id="@+id/checkStepFree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/institution_step_free" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/institution_entrance_type_label"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerEntranceType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <CheckBox
        android:id="@+id/checkAccessibleToilet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/institution_accessible_toilet" />

    <CheckBox
        android:id="@+id/checkAccessibleParking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/institution_accessible_parking" />

    <CheckBox
        android:id="@+id/checkElevator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/institution_elevator" />

    <CheckBox
        android:id="@+id/checkTactilePaving"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/institution_tactile_paving" />

    <CheckBox
        android:id="@+id/checkAudioSignage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/institution_audio_signage" />

    <CheckBox
        android:id="@+id/checkRampWidthOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/institution_ramp_width_ok" />

    <EditText
        android:id="@+id/editInstitutionNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/institution_notes_hint"
        android:inputType="textMultiLine"
        android:minLines="2" />

    <TextView
        android:id="@+id/institutionLocationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="11sp"
        android:textColor="#888888" />

</LinearLayout>
</ScrollView>
